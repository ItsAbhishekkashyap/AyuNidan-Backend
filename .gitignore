# Dependency Directories (Never push this, cloud platforms install it fresh)
node_modules/
/package-lock.json (Optional: some keep it, but skip pushing if deploying containerized)

# Env Secrets (CRITICAL - Absolute Security)
.env
.env.local
.env.production
.env.development
*.env

# Build & Compiled Output (If using TypeScript/Babel compilation)
dist/
build/
out/

# Debug and System Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Local Uploads/Temporary Storage (Multer buffer storage file drop boundaries)
uploads/
temp/
storage/

# OS Specific Metadata
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
# Evaluation run outputs (regenerate with npm run eval)
eval/results/

# Local Hugging Face model cache (downloaded on first use)
.cache/

# Processed reference-ingestion reports (regenerate with npm run kb:ingest)
medical-reference/processed/

# Generated demo PDF (npm run demo:pdf)
demo-assets/

# Unused Tesseract model (no OCR engine is used; images are read by the multimodal model)
*.traineddata

# Copyrighted / licensed source documents and datasets are NOT committed (see the README files in these folders)
medical-reference/clinical-guidelines/*.pdf
medical-reference/terminology/**/*.zip
medical-reference/terminology/**/*.xml
# Operator's local test PDF (may contain real-looking report data)
medical-reference/Sample-Smart-Report-Clinics.pdf

# Private notes (interview/resume docs) - not published
docs/
