# ── Server ──
NODE_ENV=development
PORT=8080
# Express "trust proxy" (set to 1 behind a single reverse proxy such as Render/Vercel)
TRUST_PROXY=
# Allowed browser origins (comma-separated). Dev default: localhost and 127.0.0.1 on ports 3000 and 3001.
# CORS_ORIGINS=http://localhost:3000

# ── Database (required) ──
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ── Auth (required) ──
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# ── AI providers (at least one required for AI features; tried in this order) ──
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY
# Primary model (verified available on this project): gemini-3.5-flash-lite; fallback verified: gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-call timeout, overall deadline across fallbacks, models tried, SDK retries per model (max 3)
# AI_TIMEOUT_MS=45000
# AI_TOTAL_BUDGET_MS=120000
# AI_MAX_MODEL_ATTEMPTS=3
# AI_MAX_RETRIES=1
# Max characters of source text sent for extraction (excess is truncated and flagged)
# AI_MAX_EXTRACTION_CHARS=60000
# Circuit breaker: skip a model after 404 (retired), 401/403, or 429 (quota) for these durations
# AI_BREAKER_UNAVAILABLE_MS=1800000
# AI_BREAKER_AUTH_MS=600000
# AI_BREAKER_RATE_LIMIT_MS=60000

# ── Local embeddings (Hugging Face, runs in-process; no paid API) ──
# HF_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# HF_EMBEDDING_DIMENSIONS=384
# HF_EMBEDDING_POOLING=cls
# HF_EMBEDDING_DTYPE=q8
# HF_EMBEDDING_BATCH_SIZE=32
# HF_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
# HF_CACHE_DIR=.cache/hf-models
# HF_WARMUP=true

# ── RAG ──
PINECONE_API_KEY=
# Index for the local 384-d bge space (create with: npm run vector:setup)
# PINECONE_INDEX=ayunidan-bge-small-384
# PINECONE_REGION=us-east-1
# PINECONE_TIMEOUT_MS=15000
# PINECONE_MAX_RETRIES=1
# Document retrieval (defaults are starting points; measure with: npm run eval -- --live)
# RAG_DOC_TOP_K=5
# Thresholds are embedding-space specific; defaults set from: npm run eval -- --embedder=hf
# RAG_DOC_MIN_SCORE=0.68
# RAG_REF_MIN_SCORE=0.66
# Medical terminology domain (NLM MedlinePlus + MeSH); exact term/synonym matches bypass the floor
# RAG_TERM_MIN_SCORE=0.7
# RAG_TERM_TOP_K=4
# A risk level must cite at least one verified reference (set false only for experiments)
# RAG_REQUIRE_REFERENCE_FOR_ASSESSMENT=true
# RAG_REF_TOP_K=4
# RAG_REF_MAX_QUERIES=6
# RAG_TABLE_ROWS_PER_CHUNK=8
# Serve sources of type synthetic_test as references. TEST/EVAL ONLY — never enable in production.
# RAG_INCLUDE_SYNTHETIC_REFERENCES=false
# RAG_MAX_CONTEXT_CHARS=8000
# RAG_MAX_CHUNKS_PER_DOCUMENT=200
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# Glossary retrieval
# RAG_GLOSSARY_TOP_K=2
# RAG_GLOSSARY_MIN_SCORE=0.7

# ── Rate limits (in-memory, per instance) ──
# AI_RATE_LIMIT_MAX=10
# AI_RATE_LIMIT_WINDOW_MS=60000
# GENERAL_RATE_LIMIT_MAX=100
# GENERAL_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
# LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000

# ── Uploads ──
# UPLOAD_MAX_FILE_MB=15
# VOICE_MAX_FILE_MB=15
# VOICE_MAX_DURATION_SEC=300
# VOICE_MIN_BYTES=2048
